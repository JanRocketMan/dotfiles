.config/slurm/cluster.conf

# Pi machine-specific / secret state
.pi/agent/auth.json
.pi/agent/trust.json
.pi/agent/sessions/

# Claude Code transient state
.claude/.credentials.json
.claude/.last-cleanup
.claude/mcp-needs-auth-cache.json
.claude/settings.local.json
.claude/backups/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/paste-cache/
.claude/plans/
.claude/plugins/
.claude/projects/
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/
.claude/tasks/
.claude/history.jsonl
.claude/policy-limits.json
.claude/.nfs*

# Zsh generated/local
.zsh_history
.zshrc.local
.zcompdump*

# vifm generated
.config/vifm/vifminfo.json
.config/vifm/vifm-help.txt
.config/vifm/scripts/README

# Generated files
*.pyc
__pycache__/

# ── install.sh-managed toolchain ──────────────────────────────────────────────
# On a fresh machine, `stow .` tree-folds ~/.local and ~/.config into symlinks
# pointing at this repo, so install.sh's downloads (and app state) land in the
# repo tree. Deploy with `stow --no-folding .` to avoid this; these patterns are
# the safety net regardless. Everything below is re-downloadable from TOOLS.md.

# Downloaded binaries / tool shims in ~/.local/bin (rg, fd, fzf, jq, zsh, jj,
# glab, vifm, uv, uvx, bwrap, mitm*, uv's env scripts). Track only hand-authored
# scripts via an explicit allowlist below.
.local/bin/*
!.local/bin/claude-context

# zsh extracted from the system .deb (modules + functions)
.local/lib/zsh/
.local/share/zsh/

# zinit plugin manager (git-cloned by install.sh)
.local/share/zinit/

# App-generated runtime state and desktop entries
.local/state/
.local/share/applications/

# uv local data (tool venvs, cache, credentials)
.local/share/uv/

# Neovim plugin/runtime data (lazy.nvim installs, netrw history, etc.).
# Config lives in .config/nvim/; .config/nvim/lazy-lock.json pins versions.
.local/share/nvim/

# uv installer artifacts
.config/uv/
.config/fish/conf.d/uv.env.fish

# glab config (config.yml holds a personal access token) + aliases
.config/glab-cli/

# jj user config (identity/aliases) — keep machine-local
.config/jj/

# Desktop default-app associations (machine/DE-specific)
.config/mimeapps.list
